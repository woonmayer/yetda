# Template for Casks/yetda.rb in the tap (woonmayer/homebrew-tap).
# scripts/render-cask.sh fills @VERSION@, @SHA256@ and @RELEASE_REPO@.
cask "yetda" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@RELEASE_REPO@/releases/download/v#{version}/Yetda-#{version}.dmg"
  name "Yetda"
  desc "Puts screenshots into coding agents, with secrets masked first"
  homepage "https://woonmayer.github.io/yetda/"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :ventura"

  app "Yetda.app"

  uninstall quit: "io.github.woonmayer.yetda"

  zap trash: [
    "~/.agents/skills/shots",
    "~/.claude/skills/shots",
    "~/Library/Preferences/io.github.woonmayer.yetda.plist",
    "~/Yetda",
  ]
end
